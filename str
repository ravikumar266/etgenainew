@tool
def get_weather(city: str) -> str:
    """Get current weather for a city using OpenWeatherMap."""
    api_key = os.getenv("WEATHER_API_KEY")
    if not api_key:
        return "WEATHER_API_KEY is not set in environment."
    url = (
        f"http://api.openweathermap.org/data/2.5/weather"
        f"?q={city}&appid={api_key}&units=metric"
    )
    try:
        data = requests.get(url, timeout=10).json()
        if data.get("cod") != 200:
            return f"Weather error: {data.get('message', 'unknown error')}"
        return (
            f"City: {city}\n"
            f"Temperature: {data['main']['temp']}°C\n"
            f"Feels like: {data['main']['feels_like']}°C\n"
            f"Humidity: {data['main']['humidity']}%\n"
            f"Condition: {data['weather'][0]['description']}"
        )
    except Exception as e:
        return f"Failed to fetch weather: {str(e)}"


@tool
def create_google_doc(title: str) -> str:
    """Create a new blank Google Doc with the given title."""
    try:
        doc = _docs_service().documents().create(body={"title": title}).execute()
        doc_id = doc["documentId"]
        logger.info(f"Created doc '{title}' ({doc_id})")
        return (
            f"✅ Created Google Doc: '{title}'\n"
            f"ID: {doc_id}\n"
            f"URL: https://docs.google.com/document/d/{doc_id}/edit"
        )
    except HttpError as e:
        return f"❌ Error creating doc: {e}"


@tool
def read_google_doc(document_id: str) -> str:
    """Read and return all text content from a Google Doc by its document ID."""
    try:
        doc = _docs_service().documents().get(documentId=document_id).execute()
        title = doc.get("title", "Untitled")
        text_parts = []
        for block in doc.get("body", {}).get("content", []):
            para = block.get("paragraph")
            if para:
                for el in para.get("elements", []):
                    tr = el.get("textRun")
                    if tr:
                        text_parts.append(tr.get("content", ""))
        content = "".join(text_parts).strip()
        return f"📄 Title: {title}\n\n{content or '(document is empty)'}"
    except HttpError as e:
        return f"❌ Error reading doc: {e}"


@tool
def append_to_google_doc(document_id: str, text: str) -> str:
    """Append text to the end of an existing Google Doc."""
    try:
        svc = _docs_service()
        doc = svc.documents().get(documentId=document_id).execute()
        title = doc.get("title", "Untitled")
        end_index = doc["body"]["content"][-1]["endIndex"] - 1
        svc.documents().batchUpdate(
            documentId=document_id,
            body={
                "requests": [
                    {
                        "insertText": {
                            "location": {"index": end_index},
                            "text": f"\n{text}",
                        }
                    }
                ]
            },
        ).execute()
        preview = text[:100] + ("..." if len(text) > 100 else "")
        return f"✅ Appended to '{title}'\nAdded: {preview}"
    except HttpError as e:
        return f"❌ Error appending to doc: {e}"


# ── Internal pipeline helpers (NOT in TOOLS — Gemini cannot call these) ───────

def _read_emails_raw() -> str:
    """
    Fetch 5 most recent unread Gmail messages.
    Returns sender, subject, and decoded body preview for each.
    Private — used only by check_updates() and _scheduled_check_updates().
    """
    import base64

    try:
        service = _gmail_service()
        results = service.users().messages().list(
            userId="me",
            labelIds=["INBOX", "UNREAD"],
            maxResults=5,
        ).execute()

        messages = results.get("messages", [])
        if not messages:
            return "No unread emails found."

        email_data = []
        for msg in messages:
            detail = service.users().messages().get(
                userId="me",
                id=msg["id"],
                format="full",
            ).execute()

            headers = detail.get("payload", {}).get("headers", [])
            subject = next(
                (h["value"] for h in headers if h["name"] == "Subject"),
                "(no subject)",
            )
            sender = next(
                (h["value"] for h in headers if h["name"] == "From"),
                "(unknown sender)",
            )

            # Decode plain-text body; fall back to snippet
            body_text = ""
            payload = detail.get("payload", {})
            parts = payload.get("parts", [payload])
            for part in parts:
                if part.get("mimeType") == "text/plain":
                    data = part.get("body", {}).get("data", "")
                    if data:
                        body_text = base64.urlsafe_b64decode(data).decode(
                            "utf-8", errors="ignore"
                        )
                        break

            preview = body_text[:500].strip() or detail.get("snippet", "")
            email_data.append(
                f"From: {sender}\nSubject: {subject}\nPreview: {preview}"
            )

        return "\n\n---\n\n".join(email_data)

    except Exception as e:
        return f"Error reading emails: {str(e)}"


def _filter_important(emails_text: str) -> str:
    """
    Ask the LLM to extract important items from raw email text.
    Private — called only by check_updates() and _scheduled_check_updates().
    """
    prompt = f"""You are an email triage assistant.

Read the emails below and extract ONLY the important items:
- Deadlines or due dates
- Meeting requests or schedule changes
- Urgent or time-sensitive updates
- Job offers, interviews, or college admissions

Return clean bullet points. If nothing important is found, say "No important updates."

EMAILS:
{emails_text}
"""
    try:
        result = _llm.invoke(prompt)
        return result.content
    except Exception as e:
        return f"Failed to summarise emails: {str(e)}"


def _send_email_direct(to: str, subject: str, body: str) -> None:
    """
    Send an email via SMTP with no human approval gate.
    Private — used ONLY by the background scheduler for automated
    notifications. Never expose this as a @tool.

    FIX #5: recipient passed as argument, read from env var at call site —
            never hardcoded as "your_email@gmail.com".
    FIX #6: defined HERE, before _scheduled_check_updates which calls it.
    """
    sender = os.getenv("EMAIL_USER")
    password = os.getenv("EMAIL_PASS")

    if not sender or not password:
        logger.error("[Scheduler] EMAIL_USER or EMAIL_PASS not set — cannot send notification")
        return

    try:
        msg = MIMEText(body)
        msg["Subject"] = subject
        msg["From"] = sender
        msg["To"] = to
        with smtplib.SMTP("smtp.gmail.com", 587) as server:
            server.starttls()
            server.login(sender, password)
            server.send_message(msg)
        logger.info(f"[Scheduler] Notification email sent to {to}")
    except Exception as e:
        logger.error(f"[Scheduler] Notification email failed: {e}")


